{
  "name": "jijian-notes",
  "version": "0.9.1",
  "description": "极简笔记（Jijian Notes）- 本地知识库笔记软件",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5180 && npm run build:main && npm run build:preload && electron .",
    "check:tiptap-versions": "node scripts/check-tiptap-versions.cjs",
    "check:theme-colors": "node scripts/check-theme-colors.cjs",
    "build": "npm run check:tiptap-versions && npm run build:main && npm run build:preload && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "node scripts/build-preload.js",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "test": "npm run check:tiptap-versions && vitest run"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "notes",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@floating-ui/dom": "1.8.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code-block-lowlight": "3.30.5",
    "@tiptap/extension-details": "3.30.5",
    "@tiptap/extension-drag-handle-react": "3.30.5",
    "@tiptap/extension-highlight": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-node-range": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-text-style": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.1.6",
    "lowlight": "^2.9.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.1",
    "mind-elixir": "5.15.1",
    "openai": "^7.8.0",
    "react": "^18.2.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^18.2.0",
    "react-resizable": "^4.0.2",
    "react-zoom-pan-pinch": "^4.0.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.jijian.notes",
    "productName": "极简笔记",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@excalidraw/excalidraw/dist/prod/fonts",
        "to": "fonts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@excalidraw/excalidraw/**"
    ],
    "icon": "icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "极简笔记",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
