{
  "name": "jijian-notes",
  "version": "0.9.1",
  "description": "极简笔记 - 本地知识库笔记软件",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5180 && npm run build:main && npm run build:preload && electron .",
    "build": "npm run build:main && npm run build:preload && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "node scripts/build-preload.js",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "notes",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@floating-ui/dom": "1.8.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code-block-lowlight": "3.30.5",
    "@tiptap/extension-details": "3.30.5",
    "@tiptap/extension-drag-handle-react": "3.30.5",
    "@tiptap/extension-highlight": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-node-range": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-text-style": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "dompurify": "^3.1.6",
    "lowlight": "^2.9.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.1",
    "mind-elixir": "^5.10.0",
    "react": "^18.2.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^18.2.0",
    "react-resizable": "^4.0.2",
    "react-zoom-pan-pinch": "^4.0.4",
    "uuid": "^9.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.jijian.notes",
    "productName": "极简笔记",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@excalidraw/excalidraw/dist/prod/fonts",
        "to": "fonts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@excalidraw/excalidraw/**"
    ],
    "icon": "icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "极简笔记",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
